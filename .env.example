# Local development template. Copy to .env and keep that copy untracked.
# No real credentials belong in this file. Secrets are resolved from the
# environment first, then the worker-env vault using the karta context.

KARTA_ENV=local

# Vault credentials may be left blank here and sourced from
# ~/docker/stack/.env instead.
VAULT_URL=
VAULT_TOKEN=

# Internal service endpoints. Bind loopback only; never publish to 0.0.0.0.
MARGA_BASE_URL=http://127.0.0.1:8010
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
