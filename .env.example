# Local development template. Copy to .env and keep that copy untracked.
# No real credentials belong in this file. Provider secrets are resolved from
# the environment first, then the worker-env vault using the karta context.

KARTA_ENV=local
KARTA_TENANT_ID=local

# Required for API authentication and internal service calls. Generate unique
# values locally; do not reuse committed examples.
KARTA_API_TOKEN=
KARTA_INTERNAL_TOKEN=

# Local Compose services bind 127.0.0.1 only. Generate a local password; do not
# commit the value.
KARTA_POSTGRES_PASSWORD=
KARTA_DATABASE_URL=postgresql+psycopg://karta:change-me@127.0.0.1:55432/karta
KARTA_REDIS_URL=redis://127.0.0.1:56379/0

# Marga is a separately versioned service (ADR-002). llama.cpp on the Windows
# host is reached at http://127.0.0.1:8080/v1 and exposed by Marga.
KARTA_MARGA_URL=http://127.0.0.1:8010/v1
KARTA_MARGA_API_KEY=

# Runtime and queue wiring.
KARTA_RUNTIME_URL=http://127.0.0.1:8101
KARTA_QUEUE_BACKEND=redis
KARTA_EMBED_WORKER=0
KARTA_PROJECTS_ROOT=./.local/projects

# Vault credentials may be left blank here and sourced from
# ~/docker/stack/.env instead.
VAULT_URL=
VAULT_TOKEN=

# Optional observability endpoint (Milestone 5).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
